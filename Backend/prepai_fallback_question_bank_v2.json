  "mcq_topics": {
    "oops": {
      "name": "OOPs",
      "questions": [
        {
          "id": "MCQ-OOPS-01",
          "question": "Which OOP principle bundles data and the methods that operate on that data into one unit?",
          "options": {
            "A": "Inheritance",
            "B": "Encapsulation",
            "C": "Polymorphism",
            "D": "Compilation"
          },
          "correct_option": "B",
          "explanation": "Encapsulation combines data and related methods in a class and controls access to internal state."
        },
        {
          "id": "MCQ-OOPS-02",
          "question": "Which OOP concept allows a class to acquire properties and methods from another class?",
          "options": {
            "A": "Inheritance",
            "B": "Abstraction",
            "C": "Encapsulation",
            "D": "Overloading"
          },
          "correct_option": "A",
          "explanation": "Inheritance lets a child class reuse or extend features of a parent class."
        },
        {
          "id": "MCQ-OOPS-03",
          "question": "What is an object in object-oriented programming?",
          "options": {
            "A": "A database query",
            "B": "An instance of a class",
            "C": "A programming language",
            "D": "A loop"
          },
          "correct_option": "B",
          "explanation": "A class is a blueprint; an object is a particular instance created from that class."
        },
        {
          "id": "MCQ-OOPS-04",
          "question": "Which concept means showing essential features while hiding implementation details?",
          "options": {
            "A": "Inheritance",
            "B": "Polymorphism",
            "C": "Abstraction",
            "D": "Instantiation"
          },
          "correct_option": "C",
          "explanation": "Abstraction exposes necessary operations while hiding internal implementation details."
        },
        {
          "id": "MCQ-OOPS-05",
          "question": "Polymorphism generally means:",
          "options": {
            "A": "One interface, many possible forms",
            "B": "A class has no methods",
            "C": "Data is stored only in files",
            "D": "A program has one variable"
          },
          "correct_option": "A",
          "explanation": "Polymorphism allows the same interface or method call to behave differently for different objects."
        }
      ]
    },
    "dbms": {
      "name": "DBMS",
      "questions": [
        {
          "id": "MCQ-DBMS-01",
          "question": "Which key uniquely identifies each row in a table?",
          "options": {
            "A": "Foreign key",
            "B": "Primary key",
            "C": "Candidate value",
            "D": "Duplicate key"
          },
          "correct_option": "B",
          "explanation": "A primary key uniquely identifies each row and cannot contain NULL values."
        },
        {
          "id": "MCQ-DBMS-02",
          "question": "Which SQL command is used to retrieve data from a table?",
          "options": {
            "A": "UPDATE",
            "B": "DELETE",
            "C": "SELECT",
            "D": "INSERT"
          },
          "correct_option": "C",
          "explanation": "SELECT retrieves rows and columns from one or more tables."
        },
        {
          "id": "MCQ-DBMS-03",
          "question": "Which JOIN returns rows with matching values in both tables?",
          "options": {
            "A": "INNER JOIN",
            "B": "CROSS JOIN",
            "C": "FULL OUTER JOIN",
            "D": "SELF JOIN"
          },
          "correct_option": "A",
          "explanation": "INNER JOIN returns only rows that satisfy the join condition in both tables."
        },
        {
          "id": "MCQ-DBMS-04",
          "question": "What is the main purpose of database normalization?",
          "options": {
            "A": "Increase duplicate data",
            "B": "Reduce redundancy and update anomalies",
            "C": "Remove all table relationships",
            "D": "Encrypt every column"
          },
          "correct_option": "B",
          "explanation": "Normalization organizes data to reduce unnecessary duplication and insertion, update, and deletion anomalies."
        },
        {
          "id": "MCQ-DBMS-05",
          "question": "Which ACID property ensures that a transaction is completed fully or not applied at all?",
          "options": {
            "A": "Consistency",
            "B": "Isolation",
            "C": "Durability",
            "D": "Atomicity"
          },
          "correct_option": "D",
          "explanation": "Atomicity makes a transaction all-or-nothing: either all its operations succeed or none are applied."
        }
      ]
    },
